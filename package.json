{
  "name": "@modusoperandi/licit-toolbar",
  "version": "1.0.0",
  "type": "module",
  "description": "Modules to handle editor toolbar functionality",
  "main": "index.js",
  "types": "index.d.ts",
  "style": "styles.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MO-Movia/"
  },
  "scripts": {
    "build:clean": "rm -rf dist/ && rm -f modusoperandi-licit-toolbar-*.*.*.tgz",
    "lint:ts": "eslint src --ext .ts,.tsx --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint": "npm run lint:css & npm run lint:ts",
    "test": "jest",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "ci:bom": "cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "ci:build": "tsc --build && copyfiles --up 1 \"src/**/*.css\" dist && copyfiles --up 1 \"src/fonts/**\" dist  && copyfiles package.json dist",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i"
  },
  "peerDependencies": {
    "@modusoperandi/licit-doc-attrs-step": "file:modusoperandi-licit-doc-attrs-step-1.0.3.tgz",
    "@modusoperandi/licit-ui-commands": "file:modusoperandi-licit-ui-commands-1.0.9.tgz",
    "prosemirror-commands": "^1.1.5",
    "prosemirror-dropcursor": "^1.3.5",
    "prosemirror-gapcursor": "^1.2.2",
    "prosemirror-history": "^1.1.3",
    "prosemirror-inputrules": "^1.1.3",
    "prosemirror-model": "^1.19.4",
    "prosemirror-utils": "^1.0.0-0"
  },
  "dependencies": {
    
    "@tiptap/extension-collaboration": "^2.1.0",
    "@tiptap/extension-collaboration-cursor": "^2.1.0",
    "@tiptap/extension-highlight": "*",
    "@tiptap/extension-link": "^2.1.0",
    "@tiptap/extension-list-item": "*",
    "@tiptap/extension-subscript": "^2.1.0",
    "@tiptap/extension-superscript": "^2.1.0",
    "@tiptap/extension-table": "^2.1.0",
    "@tiptap/extension-table-cell": "^2.1.0",
    "@tiptap/extension-table-header": "^2.1.0",
    "@tiptap/extension-table-row": "^2.1.0",
    "@tiptap/extension-task-item": "*",
    "@tiptap/extension-task-list": "*",
    "@tiptap/extension-text-align": "^2.1.0",
    "@tiptap/extension-underline": "^2.1.0",
    "@tiptap/starter-kit": "^2.1.0",
    "@types/prosemirror-state": "^1.2.8",
    "@types/prosemirror-test-builder": "^1.1.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@tiptap/react": "^2.0.0",
    "classnames": "^2.3.2",
    "color": "^4.2.3",
    "nullthrows": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "@cyclonedx/cyclonedx-npm": "^1.11.0",
    "@testing-library/jest-dom": "^6.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/color": "^3.0.3",
    "@types/jest": "^29.1.2",
    "@types/node": "^20.11.10",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.0.1",
    "copyfiles": "^2.4.1",
    "enzyme": "^3.11.0",
    "eslint": "8.57.0",
	 "@modusoperandi/licit-doc-attrs-step": "file:modusoperandi-licit-doc-attrs-step-1.0.3.tgz",
    "@modusoperandi/licit-ui-commands": "file:modusoperandi-licit-ui-commands-1.0.9.tgz",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "7.35.0",
    "husky": "^9.0.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.2.0",
    "jest-environment-jsdom": "^29.0.3",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^2.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.2.1",
    "prettier": "^3.2.5",
    "prosemirror-test-builder": "^1.0.6",
    "resize-observer-polyfill": "1.5.1",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-prettier": "^5.0.0",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.9.1"
  },
  "overrides": {
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "semver": "^7.5.2"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix"
    ],
    "!(*test|*.setup).ts": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
